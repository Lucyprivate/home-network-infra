#!/bin/sh /etc/rc.common
USE_PROCD=1
START=18
STOP=10

start_service() {
    # Do not create an idle/confirmed instance: a terminal worker stops this
    # service before exiting, so procd respawn cannot churn after confirmation.
    /usr/sbin/openwrt-admin-switch _needs-watch || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/openwrt-admin-switch watch
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param term_timeout 10
    procd_close_instance
}
