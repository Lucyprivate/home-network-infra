#!/bin/sh
# A single IPv4 egress owner. No HomeProxy configuration is written here.
set -u
umask 077

VPE_STORE=${VPE_STORE:-/etc/vpn-egress}
VPE_RUN=${VPE_RUN:-/var/run/vpn-egress}
VPE_IP=${VPE_IP:-/sbin/ip}
VPE_UCI=${VPE_UCI:-uci}
VPE_CURL=${VPE_CURL:-curl}
VPE_FLOCK=${VPE_FLOCK:-flock}
VPE_CONNTRACK=${VPE_CONNTRACK:-conntrack}
VPE_TIMEOUT=${VPE_TIMEOUT:-timeout}
VPE_DNSMASQ=${VPE_DNSMASQ:-/etc/init.d/dnsmasq}
VPE_ID=${VPE_ID:-id}
VPE_INTERVAL=${VPE_INTERVAL:-30}
VPE_LOCKED=0
VPE_SLEEP_PID=
IFACE=wg_exit
ADDRESS={{WG_CLIENT_IP}}
LAN_CIDR='{{LAN_CIDR}}'
ENDPOINT={{VPS_PUBLIC_IP}}
PORT=51820
TABLE=200
PROBE_PREF=19990
PROD_PREF=20100
LABEL='vpn-exit'
STATE=$VPE_STORE/state
HEALTH=$VPE_RUN/health

die() { printf 'vpn-egress: %s\n' "$*" >&2; exit 1; }
utc() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
mono() { read -r up idle < /proc/uptime; printf '%s\n' "${up%%.*}"; }
event() { logger -t vpn-egress -- "$*" 2>/dev/null || :; }
get_state() { [ ! -f "$STATE" ] || sed -n "s/^$1=//p" "$STATE"; }
get_health() { [ ! -f "$HEALTH" ] || sed -n "s/^$1=//p" "$HEALTH"; }
ipv4() {
 printf '%s\n' "$1" | awk -F. 'NF!=4 {exit 1} {for(i=1;i<=4;i++) if($i!~/^[0-9]+$/ || length($i)>3 || $i+0>255) exit 1}'
}
ipv4_cidr() {
 printf '%s\n' "$1" | awk -F/ '
  NF!=2 || $2!~/^(0|[1-9][0-9]?)$/ || $2+0>32 {exit 1}
  {if(split($1,a,".")!=4)exit 1; value=0
   for(i=1;i<=4;i++){if(a[i]!~/^[0-9]+$/ || length(a[i])>3 || a[i]+0>255 || (length(a[i])>1&&substr(a[i],1,1)=="0"))exit 1;value=value*256+a[i]}
   size=2^(32-$2);if(value%size!=0)exit 1}'
}
dependencies() {
 # Discover missing runtime tools before creating state or changing routes.
 for tool in "$VPE_IP" "$VPE_UCI" "$VPE_CURL" "$VPE_FLOCK" "$VPE_CONNTRACK" "$VPE_TIMEOUT" "$VPE_DNSMASQ" awk sort sed logger date chmod mkdir mv grep cat rm sleep id; do
  command -v "$tool" >/dev/null 2>&1 || { printf 'vpn-egress: required command unavailable: %s\n' "$tool" >&2; return 1; }
 done
 ipv4_cidr "$LAN_CIDR" || { printf 'vpn-egress: invalid LAN CIDR\n' >&2; return 1; }
}
private_dirs() {
 [ ! -L "$VPE_STORE" ] && [ ! -L "$VPE_RUN" ] || die 'private directory is a symlink'
 mkdir -p "$VPE_STORE" "$VPE_RUN" || die 'private directory unavailable'
 chmod 700 "$VPE_STORE" "$VPE_RUN" || die 'private directory permissions'
 for p in "$STATE" "$HEALTH" "$VPE_RUN/status.json" "$VPE_RUN/operation.lock"; do
  [ ! -L "$p" ] || die 'state path is a symlink'
  [ ! -e "$p" ] || [ -f "$p" ] || die 'state path is not regular'
 done
}
lock() {
 exec 9>"$VPE_RUN/operation.lock"
 # OpenWrt's BusyBox flock supports -n, but not util-linux's -w timeout.
 lock_deadline=$(($(mono) + 20))
 while ! "$VPE_FLOCK" -n 9; do
  [ "$(mono)" -lt "$lock_deadline" ] || { exec 9>&-; return 1; }
  sleep 1
 done
 VPE_LOCKED=1
}
unlock() {
 [ "$VPE_LOCKED" = 1 ] || return 0
 "$VPE_FLOCK" -u 9
 exec 9>&-
 VPE_LOCKED=0
}
state_write() {
 case "$1" in WG_ACTIVE|DIRECT_LATCHED) : ;; *) return 1 ;; esac
 case "$2" in *[!a-z0-9_]*) return 1 ;; esac
 printf 'schema=1\nmode=%s\nreason=%s\nupdated_utc=%s\n' "$1" "$2" "$(utc)" > "$VPE_STORE/.state.$$" &&
  chmod 600 "$VPE_STORE/.state.$$" && mv "$VPE_STORE/.state.$$" "$STATE"
}
health_write() {
 printf 'failures=%s\ntunnel_healthy=%s\nlast_health_utc=%s\n' "$1" "$2" "$(utc)" > "$VPE_RUN/.health.$$" &&
  chmod 600 "$VPE_RUN/.health.$$" && mv "$VPE_RUN/.health.$$" "$HEALTH"
}

# Priorities and complete selectors are the ownership boundary. A foreign rule
# at any reserved priority prevents modifications instead of being deleted.
rule_specs() {
 printf '%s|from %s lookup %s\n' "$PROBE_PREF" "$ADDRESS" "$TABLE"
 n=20000
 for dst in 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4 "$ENDPOINT"; do
  printf '%s|from all to %s lookup main\n' "$n" "$dst"
  n=$((n + 1))
 done
 printf '%s|from all lookup %s\n' "$PROD_PREF" "$TABLE"
}
rule_line() {
 "$VPE_IP" -4 rule show | awk -v p="$1:" '$1==p {$1=""; sub(/^[[:space:]]+/, ""); gsub(/[[:space:]]+/, " "); gsub(/\/32/, ""); gsub(/lookup 254/, "lookup main"); print}'
}
rules_preflight() {
 rule_specs > "$VPE_RUN/specs.$$"
 while IFS='|' read -r pref expected; do
  actual=$(rule_line "$pref") || return 1
  [ -z "$actual" ] || [ "$actual" = "$expected" ] || {
   event "reserved_rule_conflict priority=$pref"; return 1;
  }
 done < "$VPE_RUN/specs.$$"
 rm -f "$VPE_RUN/specs.$$"
}
table_preflight() {
 # A missing table is empty; failure with nonempty output remains a conflict.
 rows=$("$VPE_IP" -4 route show table "$TABLE" 2>/dev/null) || [ -z "$rows" ] || return 1
 printf '%s\n' "$rows" | awk -v dev="$IFACE" -v src="$ADDRESS" '
  NF==0 {next}
  {line=$0; gsub(/ linkdown/, "", line); gsub(/ scope link/, "", line); gsub(/proto bgp/, "proto 186", line); sub(/[[:space:]]+$/, "", line)}
  line=="unreachable default proto 186 metric 42760" {next}
  line=="default dev "dev" proto 186 src "src" metric 10" {next}
  {exit 1}'
}
add_rule() {
 pref=$1; shift
 existing=$(rule_line "$pref") || return 1
 desired=$(printf '%s\n' "$*" | sed 's@/32@@g')
 case "$desired" in to\ *|lookup\ *) desired="from all $desired" ;; esac
 if [ -n "$existing" ]; then [ "$existing" = "$desired" ]; else
  "$VPE_IP" -4 rule add pref "$pref" "$@"
 fi
}
base_routes() {
 rules_preflight && table_preflight || return 1
 "$VPE_IP" -4 route replace unreachable default table "$TABLE" proto 186 metric 42760 || return 1
 add_rule "$PROBE_PREF" from "$ADDRESS/32" lookup "$TABLE" || return 1
 # Do not remove the unreachable route if the interface is unavailable.
 "$VPE_IP" -4 route replace default dev "$IFACE" src "$ADDRESS" table "$TABLE" proto 186 metric 10
}
production_on() {
 rules_preflight || return 1
 n=20000
 for dst in 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4 "$ENDPOINT"; do
  add_rule "$n" to "$dst" lookup main || return 1
  n=$((n + 1))
 done
 add_rule "$PROD_PREF" lookup "$TABLE"
}
production_off() {
 rules_preflight || return 1
 # Remove catchall first so routing falls back immediately. Probe routing stays.
 actual=$(rule_line "$PROD_PREF") || return 1
 if [ -n "$actual" ]; then
  [ "$actual" = "from all lookup $TABLE" ] || return 1
  "$VPE_IP" -4 rule del pref "$PROD_PREF" lookup "$TABLE" || return 1
 fi
 n=20000
 for dst in 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4 "$ENDPOINT"; do
  actual=$(rule_line "$n") || return 1
  if [ -n "$actual" ]; then
   [ "$actual" = "from all to $dst lookup main" ] || return 1
   "$VPE_IP" -4 rule del pref "$n" to "$dst" lookup main || return 1
  fi
  n=$((n + 1))
 done
}
production_present() {
 [ "$(rule_line "$PROD_PREF")" = "from all lookup $TABLE" ]
}
status_json() {
 mode=$(get_state mode); reason=$(get_state reason); updated=$(get_state updated_utc)
 [ "$mode" = WG_ACTIVE ] || mode=DIRECT_LATCHED
 case "$reason" in ''|*[!a-z0-9_]*) reason=uninitialized ;; esac
 case "$updated" in *[!0-9TZ:-]*) updated= ;; esac
 failures=$(get_health failures); case "$failures" in ''|*[!0-9]*) failures=0 ;; esac
 healthy=$(get_health tunnel_healthy); [ "$healthy" = true ] || healthy=false
 last=$(get_health last_health_utc); case "$last" in *[!0-9TZ:-]*) last= ;; esac
 transport=direct; routing=false; consistent=true
 catchall=$(rule_line "$PROD_PREF")
 if [ "$catchall" = "from all lookup $TABLE" ]; then
  routing=true; transport=wireguard
  [ "$mode" = WG_ACTIVE ] || { consistent=false; healthy=false; }
 elif [ -n "$catchall" ]; then
  consistent=false; healthy=false; reason=reserved_rule_conflict
 fi
 [ "$mode" != WG_ACTIVE ] || [ "$routing" = true ] || {
  mode=DIRECT_LATCHED; reason=production_rule_missing; healthy=false; consistent=false;
 }
 printf '{"schema":1,"mode":"%s","transport":"%s","node_label":"%s","endpoint":{"address":"%s","port":%s,"protocol":"udp"},"expected_exit_ipv4":"%s","failures":%s,"tunnel_healthy":%s,"last_health_utc":"%s","reason":"%s","updated_utc":"%s","production_routing":%s,"routing_consistent":%s}\n' \
  "$mode" "$transport" "$LABEL" "$ENDPOINT" "$PORT" "$ENDPOINT" "$failures" "$healthy" "$last" "$reason" "$updated" "$routing" "$consistent"
}
status_publish() {
 status_json > "$VPE_RUN/.status.$$" && chmod 600 "$VPE_RUN/.status.$$" && mv "$VPE_RUN/.status.$$" "$VPE_RUN/status.json"
}
probe_one() {
 kind=$1; path=$2
 case "$kind" in
  google) host=www.gstatic.com; address=$GOOGLE_IP; url=https://www.gstatic.com/generate_204 ;;
  cloudflare) host=www.cloudflare.com; address=$CLOUDFLARE_IP; url=https://www.cloudflare.com/cdn-cgi/trace ;;
 esac
 # Device binding AND source policy table have independent no-WAN-fallback
 # protection. Fixed DNS answers prevent a direct-mode probe DNS side channel.
 if ! "$VPE_CURL" --silent --show-error --proxy '' --noproxy '*' --ipv4 --interface "$IFACE" \
  --resolve "$host:443:$address" --connect-timeout 3 --max-time 8 --max-filesize 8192 \
  --output "$path.body" --write-out '%{http_code}' "$url" > "$path.code" 2>/dev/null 9>&-; then return 1; fi
 case "$kind" in
  google) [ "$(cat "$path.code")" = 204 ] ;;
  cloudflare) [ "$(cat "$path.code")" = 200 ] && grep -Fxq "ip=$ENDPOINT" "$path.body" && grep -Fxq 'h=www.cloudflare.com' "$path.body" ;;
 esac
}
health_round() {
 require_exit=$1
 GOOGLE_IP=$("$VPE_UCI" -q get vpn-egress.main.google_ipv4 2>/dev/null) || return 1
 CLOUDFLARE_IP=$("$VPE_UCI" -q get vpn-egress.main.cloudflare_ipv4 2>/dev/null) || return 1
 ipv4 "$GOOGLE_IP" && ipv4 "$CLOUDFLARE_IP" || return 1
 (probe_one google "$VPE_RUN/google.$$") 9>&- & a=$!
 (probe_one cloudflare "$VPE_RUN/cloudflare.$$") 9>&- & b=$!
 ga=0; cf=0
 wait "$a" && ga=1
 wait "$b" && cf=1
 rm -f "$VPE_RUN/google.$$.body" "$VPE_RUN/google.$$.code" "$VPE_RUN/cloudflare.$$.body" "$VPE_RUN/cloudflare.$$.code"
 # Resume must prove the promised exit, not merely arbitrary Internet access.
 [ "$require_exit" != yes ] || [ "$cf" = 1 ] || return 1
 [ "$ga" = 1 ] || [ "$cf" = 1 ]
}
conntrack_pairs() {
 # Original tuple only. No IPv6 entries, reply tuples, private destinations or
 # management/VPS connections can enter the deletion list.
 "$VPE_IP" -o -4 address show > "$VPE_RUN/addresses.$$" || return 1
 "$VPE_TIMEOUT" 3 "$VPE_CONNTRACK" -L -f ipv4 > "$VPE_RUN/conntrack.$$" 2>/dev/null || return 1
 awk -v endpoint="$ENDPOINT" -v lan="$LAN_CIDR" '
  function number(ip, a) {split(ip,a,".");return ((a[1]*256+a[2])*256+a[3])*256+a[4]}
  function in_lan(ip) {return int(number(ip)/lan_size)==lan_network}
  BEGIN {split(lan,cidr,"/");lan_size=2^(32-cidr[2]);lan_network=int(number(cidr[1])/lan_size)}
  function priv(ip, a) {split(ip,a,"."); return a[1]==0||a[1]==10||a[1]==127||a[1]>=224||
    (a[1]==100&&a[2]>=64&&a[2]<=127)||(a[1]==169&&a[2]==254)||
    (a[1]==172&&a[2]>=16&&a[2]<=31)||(a[1]==192&&a[2]==168)||
    (a[1]==192&&a[2]==0&&(a[3]==0||a[3]==2))||
    (a[1]==198&&(a[2]==18||a[2]==19))||(a[1]==198&&a[2]==51&&a[3]==100)||
    (a[1]==203&&a[2]==0&&a[3]==113)}
  function valid(ip, a,n,i) {n=split(ip,a,"."); if(n!=4)return 0;for(i=1;i<=4;i++)if(a[i]!~/^[0-9]+$/||a[i]+0>255)return 0;return 1}
  FNR==NR {for(i=1;i<=NF;i++)if($i=="inet"){split($(i+1),x,"/"); localip[x[1]]=1}next}
  {s="";d="";for(i=1;i<=NF;i++){if(s==""&&$i~/^src=/)s=substr($i,5);if(d==""&&$i~/^dst=/)d=substr($i,5)}
   if(valid(s)&&valid(d)&&d!=endpoint&&!priv(d)&&(in_lan(s)||s in localip)) print s,d}
 ' "$VPE_RUN/addresses.$$" "$VPE_RUN/conntrack.$$" | sort -u
 rm -f "$VPE_RUN/addresses.$$" "$VPE_RUN/conntrack.$$"
}
refresh_connections() {
 deadline=$(($(mono) + 8)); cleaned=0
 refreshed=0
 if conntrack_pairs > "$VPE_RUN/pairs.$$"; then
  while read -r src dst; do
   if [ "$(mono)" -ge "$deadline" ] || [ "$cleaned" -ge 512 ]; then refreshed=1; break; fi
   "$VPE_TIMEOUT" 1 "$VPE_CONNTRACK" -D -f ipv4 --orig-src "$src" --orig-dst "$dst" >/dev/null 2>&1 || {
    cleanup_rc=$?; [ "$cleanup_rc" = 1 ] || refreshed=1;
   }
   cleaned=$((cleaned + 1))
  done < "$VPE_RUN/pairs.$$"
 else
  refreshed=1
 fi
 rm -f "$VPE_RUN/pairs.$$" "$VPE_RUN/addresses.$$" "$VPE_RUN/conntrack.$$"
 # DNS is independent of conntrack enumeration. Always rebuild its upstream
 # sockets, including when the cleanup list/cap/deadline could not be met.
 "$VPE_TIMEOUT" 8 "$VPE_DNSMASQ" restart >/dev/null 2>&1 9>&- || refreshed=1
 return "$refreshed"
}
to_direct() {
 why=$1
 # Persist latch first: a process/power failure may not auto-resume afterward.
 state_write DIRECT_LATCHED "$why" || return 1
 production_off || return 1
 health_write 0 false || return 1
 status_publish || return 1
 event "mode=DIRECT_LATCHED reason=$why"
 refresh_connections
}
to_active() {
 rules_preflight && table_preflight || return 1
 command -v "$VPE_CONNTRACK" >/dev/null 2>&1 || return 1
 base_routes || { to_direct interface_unavailable; return 1; }
 health_round yes || { to_direct resume_probe_failed; return 1; }
 # Persist intent only after health/exit verification; any partial activation is
 # removed on failure, so the controller never reports an unvalidated tunnel.
 production_on || { to_direct activation_failed; return 1; }
 state_write WG_ACTIVE healthy || { production_off; return 1; }
 health_write 0 true && status_publish || { to_direct status_failed; return 1; }
 if ! refresh_connections; then to_direct connection_refresh_failed; return 1; fi
 event 'mode=WG_ACTIVE reason=healthy'
}
tick() {
 mode=$(get_state mode)
 if [ "$mode" = WG_ACTIVE ]; then
  if ! production_present; then to_direct production_rule_missing; return; fi
  if health_round no; then health_write 0 true; else
   failures=$(get_health failures); case "$failures" in ''|*[!0-9]*) failures=0 ;; esac
   failures=$((failures + 1)); health_write "$failures" false
   if [ "$failures" -ge 3 ]; then to_direct health_failed; return; fi
  fi
 else
  production_off || return 1
 fi
 status_publish
}
on_exit() {
 [ -z "$VPE_SLEEP_PID" ] || kill "$VPE_SLEEP_PID" 2>/dev/null || :
 unlock
}
watch() {
 trap 'on_exit; exit 0' TERM INT
 lock || die 'controller busy'
 # A restarted service probes independently before installing production rules.
 wanted=$(get_state mode)
 production_off || die 'routing conflict during startup'
 if [ "$wanted" = WG_ACTIVE ]; then
  to_active || :
 else
  [ "$wanted" = DIRECT_LATCHED ] || state_write DIRECT_LATCHED initial
  base_routes || :
  status_publish || die 'cannot publish startup state'
 fi
 unlock
 while :; do
  started=$(mono)
  if lock; then tick || event 'controller_tick_failed'; unlock; fi
  pause=$((VPE_INTERVAL - ($(mono) - started))); [ "$pause" -gt 0 ] || pause=1
  sleep "$pause" 9>&- & VPE_SLEEP_PID=$!; wait "$VPE_SLEEP_PID" || :; VPE_SLEEP_PID=
 done
}

case "${1:-}" in
 status) status_json; exit 0 ;;
 direct|resume|watch) [ "$($VPE_ID -u)" = 0 ] || die 'root required' ;;
 *) die 'usage: vpn-egress status|direct|resume|watch' ;;
esac
[ "$#" = 1 ] || die 'unexpected arguments'
case "$VPE_INTERVAL" in ''|*[!0-9]*) die 'invalid interval' ;; esac
[ "$VPE_INTERVAL" -ge 1 ] && [ "$VPE_INTERVAL" -le 30 ] || die 'interval must be 1..30 seconds'
dependencies || die 'runtime preflight failed; no state or routes changed'
private_dirs
trap on_exit EXIT
case "$1" in
 watch) watch ;;
 direct) lock || die 'controller busy'; to_direct manual || die 'direct transition incomplete' ;;
 resume) lock || die 'controller busy'; to_active || die 'resume refused; direct latch preserved' ;;
esac
