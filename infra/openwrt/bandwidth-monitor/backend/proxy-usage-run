#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
umask 077
dir=/var/run/proxy-usage
[ ! -L "$dir" ] || exit 1
if [ ! -e "$dir" ]; then mkdir -m 700 "$dir"; fi
/usr/bin/ucode -e 'import {lstat} from "fs"; let s=lstat("/var/run/proxy-usage"); exit(s?.type == "directory" && s.uid == 0 && s.mode == 448 ? 0 : 1);' || exit 1
[ ! -L "$dir/lock" ] || exit 1
exec 9>"$dir/lock"
flock -n 9 || exit 0
# exec preserves FD9, so procd sends SIGTERM directly to the collector and
# its lock remains held until the final atomic checkpoint is complete.
exec /usr/bin/ucode /usr/share/proxy-usage/collector.uc
