config dhcp 'lan'
        option interface 'lan'
        option start '100'
        option limit '100'
        option leasetime '12h'
        option dhcpv4 'server'
        option dhcpv6 'disabled'
        option ra 'disabled'
        option ndp 'disabled'

config dhcp 'wan'
        option interface 'wan'
        option ignore '1'

config host 'homeinfra_servicevm'
        option name 'service-host'
        option mac '{{APP_LAN_MAC}}'
        option ip '{{APP_LAN_IP}}'
