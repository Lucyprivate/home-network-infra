{
  "name": "stirling-pdf",
  "services": {
    "stirling": {
      "image": "ghcr.io/stirling-tools/stirling-pdf:3.1.0@sha256:b5b9e400c086e5334a4947a0d7cd589808f743f29267d7f41c18200cf4bc48b4",
      "container_name": "stirling-pdf",
      "restart": "no",
      "labels": {
        "io.codex.owner": "ServiceHostStirlingPDF20000101"
      },
      "cgroup_parent": "stirling-pdf.slice",
      "cpus": 1,
      "mem_limit": "1536m",
      "memswap_limit": "1536m",
      "pids_limit": 256,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "dns": [
        "127.0.0.1"
      ],
      "environment": {
        "DOCKER_ENABLE_SECURITY": "false",
        "SYSTEM_ENABLEANALYTICS": "false",
        "SYSTEM_ENABLESCARF": "false",
        "LANGS": "en_US",
        "OMP_NUM_THREADS": "1",
        "OPENBLAS_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1"
      },
      "ports": [
        {
          "host_ip": "0.0.0.0",
          "published": "8080",
          "target": 8080,
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/stirling-pdf/configs",
          "target": "/configs",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/srv/stirling-pdf/tessdata",
          "target": "/usr/share/tessdata",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/srv/stirling-pdf/local/ocrmypdf-single",
          "target": "/usr/local/bin/ocrmypdf",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/srv/stirling-pdf/local/paddle-order5-runtime",
          "target": "/usr/local/share/stirling-paddle-order2-lab",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "tmpfs": [
        "/tmp:rw,nosuid,size=512m"
      ],
      "networks": {
        "offline": {
          "ipv4_address": "172.28.50.3"
        }
      }
    }
  },
  "networks": {
    "offline": {
      "driver": "bridge",
      "enable_ipv6": false,
      "driver_opts": {
        "com.docker.network.bridge.name": "br-stirling"
      },
      "ipam": {
        "config": [
          {
            "subnet": "{{PDF_NETWORK_CIDR}}",
            "gateway": "{{PDF_NETWORK_GATEWAY}}"
          }
        ]
      }
    }
  }
}
